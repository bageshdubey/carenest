# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (aistudio.google.com > Get API key). Optional: GEMINI_MODEL, default gemini-flash-latest
GEMINI_API_KEY=

# Sarvam voice notes to the parent (dashboard.sarvam.ai > API keys). Without a key, replies go as text only.
# Voices on bulbul:v4-flash belong to one language, so each parent language has its own.
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v4-flash
SARVAM_PACE=1.0
SARVAM_SPEAKER_EN=roopa_en_conversational
SARVAM_SPEAKER_HI=roopa_hi_conversational
SARVAM_SPEAKER_MR=ishita_mr_conversational

# WhatsApp Cloud API (Meta app > WhatsApp > API Setup, and App settings > Basic)
# The number parents message (digits only), shown in the link the child shares
NEXT_PUBLIC_WHATSAPP_NUMBER=15551987592
WHATSAPP_PHONE_NUMBER_ID=1354261624444681
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Any long random text. You type the same text into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# Optional, once Meta approves the templates
WHATSAPP_TEMPLATE_REMINDER=

# Scheduler: any long random text. The same text goes into supabase/schedule.sql.
CRON_SECRET=
