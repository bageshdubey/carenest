# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta app > WhatsApp > API Setup, and App settings > Basic)
# The number parents message (digits only), shown in the link the child shares
NEXT_PUBLIC_WHATSAPP_NUMBER=15551987592
WHATSAPP_PHONE_NUMBER_ID=1354261624444681
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Any long random text. You type the same text into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# Optional, once Meta approves the templates
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_ALERT=

# Scheduler: any long random text. The same text goes into supabase/schedule.sql.
CRON_SECRET=
